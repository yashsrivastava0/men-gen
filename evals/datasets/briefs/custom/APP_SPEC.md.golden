  - open_item: {go: SCR-007}
  - open_entry_form: {go: SCR-017}
  - open_gallery: {go: SCR-009}
  - open_map: {go: SCR-012}
copy:
  intro: Show categories and featured items with shortcuts to the other parts of the app
  title: Home
