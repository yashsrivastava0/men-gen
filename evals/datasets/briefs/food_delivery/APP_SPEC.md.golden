        retrieved_at: 2026-11-08
      - url: https://example.org/mock-source/delivery-app-checklist
        title: Delivery app checklist example
        domain: example.org
        retrieved_at: 2026-11-08
    affects: [API-createRating, API-listRestaurantRatings, ENT-Rating, SCR-009, SCR-010]
    verified: true
  - id: RA-002
    title: Item options sheet
    kind: pattern
    sources:
      - url: https://example.com/mock-source/food-ordering-ux-patterns
        title: Food ordering UX patterns example
        domain: example.com
        retrieved_at: 2026-11-08
    verified: true
  - id: RA-003
    title: Plan for a development build
    kind: integration
    sources:
      - url: https://example.com/mock-source/payment-sdk-overview
        title: Payment SDK overview example
        domain: example.com
        retrieved_at: 2026-11-08
    affects: [INT-plan_for_a_development_build]
  - id: RA-004
    title: Send codes and reminders from the server
    kind: integration
