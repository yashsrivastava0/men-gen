# Names and SAFE defaults only. Copy to .env and fill in secrets locally. Never commit .env.
# One key per model vendor; a key is needed only when a route below uses one of that vendor's models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-6-luna
LLM_MODE=mock
# Set LLM_MODE=live for real model calls (the budget cap below still applies).
LLM_BUDGET_USD=6.00
LLM_BUDGET_LEDGER=data/.budget/ledger.jsonl
# Recorded provider responses (replay mode / live recording). Relative paths anchor to the main repo.
# CASSETTE_DIR=tests/cassettes
# MDE_RECORD_CASSETTES=0
# Which model serves each route. The vendor of a model is in the gateway's pricing.yaml, so switching vendor is only this line:
#   MODEL_ROUTES=fast=gpt-6-luna,standard=gpt-6-luna,deep=gpt-6-luna            (OpenAI)
#   MODEL_ROUTES=fast=claude-haiku-5-5,standard=claude-sonnet-5-5,deep=claude-haiku-5-5   (Claude)
#   MODEL_ROUTES=claude-haiku-5-5   (one model for all three routes; JSON also works)
DATABASE_URL=postgresql+psycopg://mde:mde@127.0.0.1:54329/mde
GATEWAY_MODE=inprocess
# GATEWAY_URL=http://127.0.0.1:8101
# GATEWAY_SERVICE_TOKEN=
RESEARCH_DEPTH=light
RESEARCH_CONCURRENCY=1
API_DEV_TOKEN=dev-token
PROJECTS_DIR=data/projects
LOG_LEVEL=INFO
LOG_PROMPTS=0

# Search & External APIs
TAVILY_API_KEY=
SERPER_API_KEY=

# Twilio (SMS / Voice / Auth)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
