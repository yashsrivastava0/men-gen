# Names and SAFE defaults only. Copy to .env and fill in secrets locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
LLM_MODE=mock
# Live calls need LLM_MODE=live AND ALLOW_LIVE_LLM=1 (second key). Leave unset normally.
# ALLOW_LIVE_LLM=1
LLM_BUDGET_USD=6.00
LLM_BUDGET_LEDGER=data/.budget/ledger.jsonl
# Recorded provider responses (replay mode / live recording). Relative paths anchor to the main repo.
# CASSETTE_DIR=tests/cassettes
# MDE_RECORD_CASSETTES=0
# MODEL_ROUTES={"fast":"gpt-6-luna","standard":"gpt-6-luna","deep":"gpt-6-luna"}
DATABASE_URL=postgresql+psycopg://mde:mde@127.0.0.1:54329/mde
GATEWAY_MODE=inprocess
# GATEWAY_URL=http://127.0.0.1:8101
# GATEWAY_SERVICE_TOKEN=
RESEARCH_DEPTH=light
RESEARCH_CONCURRENCY=1
API_DEV_TOKEN=dev-token
PROJECTS_DIR=data/projects
LOG_LEVEL=INFO
LOG_PROMPTS=0
