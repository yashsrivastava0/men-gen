{
  "$defs": {
    "Counters": {
      "additionalProperties": false,
      "properties": {
        "elapsed_s": {
          "default": 0,
          "title": "Elapsed S",
          "type": "integer"
        },
        "eta_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta S"
        },
        "facts_verified": {
          "default": 0,
          "title": "Facts Verified",
          "type": "integer"
        },
        "pages_read": {
          "default": 0,
          "title": "Pages Read",
          "type": "integer"
        },
        "searches_ceiling": {
          "default": 0,
          "title": "Searches Ceiling",
          "type": "integer"
        },
        "searches_planned": {
          "default": 0,
          "title": "Searches Planned",
          "type": "integer"
        },
        "searches_used": {
          "default": 0,
          "title": "Searches Used",
          "type": "integer"
        },
        "targets_done": {
          "default": 0,
          "title": "Targets Done",
          "type": "integer"
        },
        "targets_total": {
          "default": 0,
          "title": "Targets Total",
          "type": "integer"
        }
