      "enum": [
        "run.started",
        "plan.ready",
        "target.started",
        "target.covered",
        "target.not_found",
        "target.cancelled",
        "query.issued",
        "search.results",
        "page.reading",
        "page.read",
        "page.skipped",
        "fact.found",
        "fact.verified",
        "fact.rejected",
        "entity.discovered",
        "round.completed",
        "gap.detected",
        "warning",
        "run.finished",
        "run.skipped",
        "run.failed"
      ],
      "title": "Type",
      "type": "string"
    }
