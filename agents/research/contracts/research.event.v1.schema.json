      "title": "Detail",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "phase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phase"
    },
    "round": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Round"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "default": "research.event.v1",
      "title": "Schema",
      "type": "string"
    },
    "seq": {
      "title": "Seq",
      "type": "integer"
    },
    "target_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
