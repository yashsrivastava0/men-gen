SCHEMA (one JSON object with these arrays; every array may be empty)
entities: {id, name, klass, typical_count (0 = not stated), max_count, prov[]}
fields: {entity, key (lower snake case), type, required, enum_values[], ref_entity, derived_rule, constraint, media}
states: {entity, state, initial}   (one initial per entity; list the statuses in order)
transitions: {entity, from_state, to_state, roles[] (role ids), on (an operation id or empty)}
rules: {id, subject, statement, condition, value, unit, entity, confirm, prov[]}
operations: {id (NEW-key), name, entity, method, path (starts with /), roles[], idempotent, paged, prov[]}
op_fields: {op, side, key, type, required}
op_errors: {op, code, recovery}
stories: {id, role (a role id), want, so_that, feature_ids[], policy_id, screen_ids[], voice, prov[]}
acceptance: {story, given, when, then}
