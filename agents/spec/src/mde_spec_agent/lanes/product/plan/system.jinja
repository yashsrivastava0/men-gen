merges: {keep, drop, reason, prov[]}
splits: {screen, part, name, purpose, region_keys[], action_keys[], reason, prov[]}
modules: {id, purpose, shared, depends_on[], prov[]}
roles: {id, goal, home_screen, prov[]}
access: {entity, role, actions[], prov[]}
owners: {entity, module, reason, prov[]}
personas: {role, goal, context, frequency, skill, pain_points[], success, prov[]}
release: {feature, status, reason, why, consent_needed, prov[]}
