[importlinter]
root_packages =
    mde_core
    mde_contracts
    mde_llm_gateway
    mde_prompts
    mde_content
    mde_persistence
    mde_spec_loader
    mde_discovery
    mde_research
    mde_spec_builder
    mde_flow
    mde_compass
    mde_research_agent
    mde_spec_core
    mde_compass_intake
    mde_spec_agent
    mde_verify_agent
    mde_context_api
    mde_llm_gateway_api
    mde_cli
include_external_packages = True

[importlinter:contract:layers]
name = Package layering (brief 5.2)
type = layers
layers =
    mde_cli
    mde_context_api | mde_llm_gateway_api | mde_compass | mde_research_agent | mde_spec_agent | mde_verify_agent
    mde_flow
    mde_discovery | mde_research | mde_spec_builder
    mde_prompts
    mde_llm_gateway | mde_content | mde_persistence | mde_spec_loader | mde_spec_core | mde_compass_intake
    mde_contracts
    mde_core

[importlinter:contract:engines-independent]
name = Engines never import each other (flow wires them through contracts)
type = independence
modules =
    mde_discovery
    mde_research
    mde_spec_builder

[importlinter:contract:foundations-independent]
name = Foundation packages do not import each other
type = independence
modules =
    mde_llm_gateway
    mde_content
    mde_persistence
    mde_spec_loader
    mde_spec_core
    mde_compass_intake

[importlinter:contract:only-gateway-imports-model-sdks]
name = Only mde_llm_gateway may import a model vendor SDK (openai, anthropic; rule 14)
type = forbidden
source_modules =
    mde_core
    mde_contracts
    mde_prompts
    mde_content
    mde_persistence
    mde_spec_loader
    mde_discovery
    mde_research
    mde_spec_builder
    mde_flow
    mde_compass
    mde_research_agent
    mde_spec_core
    mde_compass_intake
    mde_spec_agent
    mde_verify_agent
    mde_context_api
    mde_llm_gateway_api
    mde_cli
forbidden_modules =
    openai
    anthropic
allow_indirect_imports = True

[importlinter:contract:no-agent-frameworks-no-sqlite]
name = No agent frameworks, no SQLite, anywhere
type = forbidden
source_modules =
    mde_core
    mde_contracts
    mde_llm_gateway
    mde_prompts
    mde_content
    mde_persistence
    mde_spec_loader
    mde_discovery
    mde_research
    mde_spec_builder
    mde_flow
    mde_compass
    mde_research_agent
    mde_spec_core
    mde_compass_intake
    mde_spec_agent
    mde_verify_agent
    mde_context_api
    mde_llm_gateway_api
    mde_cli
forbidden_modules =
    langchain
    langgraph
    llama_index
    crewai
    autogen
    semantic_kernel
    dspy
    instructor
    sqlite3
    aiosqlite
allow_indirect_imports = True

[importlinter:contract:contracts-and-core-have-no-io]
name = contracts and core do no network / database / web I/O
type = forbidden
source_modules =
    mde_contracts
    mde_core
forbidden_modules =
    openai
    anthropic
    httpx
    requests
    sqlalchemy
    psycopg
    fastapi
    uvicorn
allow_indirect_imports = True

[importlinter:contract:compass-isolated]
name = Compass imports only core, contracts, llm_gateway and persistence (ADR 0012)
type = forbidden
source_modules =
    mde_compass
forbidden_modules =
    mde_discovery
    mde_research
    mde_research_agent
    mde_spec_builder
    mde_flow
    mde_prompts
    mde_content
    mde_spec_loader
    mde_spec_core
    mde_compass_intake
    mde_spec_agent
    mde_verify_agent
    mde_context_api
    mde_llm_gateway_api
    mde_cli
allow_indirect_imports = True

[importlinter:contract:research-agent-isolated]
name = The Research agent imports only core, contracts and llm_gateway (and third-party libraries); no other agent, app or the older mde_research
type = forbidden
source_modules =
    mde_research_agent
forbidden_modules =
    mde_compass
    mde_discovery
    mde_research
    mde_spec_builder
    mde_flow
    mde_prompts
    mde_content
    mde_spec_loader
    mde_persistence
    mde_spec_core
    mde_compass_intake
    mde_spec_agent
    mde_verify_agent
    mde_context_api
    mde_llm_gateway_api
    mde_cli
allow_indirect_imports = True

[importlinter:contract:spec-agent-isolated]
name = The Spec agent imports only core, contracts, llm_gateway, spec_core and compass_intake (no other agent, no Verify, no app, no legacy spec packages)
type = forbidden
source_modules =
    mde_spec_agent
forbidden_modules =
    mde_compass
    mde_discovery
    mde_research
    mde_research_agent
    mde_spec_builder
    mde_spec_loader
    mde_flow
    mde_prompts
    mde_content
    mde_persistence
    mde_verify_agent
    mde_context_api
    mde_llm_gateway_api
    mde_cli
allow_indirect_imports = True

[importlinter:contract:verify-agent-isolated]
name = The Verify agent imports only core, contracts, llm_gateway and spec_core (never the Spec agent or any other agent)
type = forbidden
source_modules =
    mde_verify_agent
forbidden_modules =
    mde_compass
    mde_compass_intake
    mde_discovery
    mde_research
    mde_research_agent
    mde_spec_builder
    mde_spec_loader
    mde_spec_agent
    mde_flow
    mde_prompts
    mde_content
    mde_persistence
    mde_context_api
    mde_llm_gateway_api
    mde_cli
allow_indirect_imports = True

[importlinter:contract:spec-core-is-foundation]
name = spec_core and compass_intake import only core and contracts (no gateway, no agent, no I/O stack)
type = forbidden
source_modules =
    mde_spec_core
    mde_compass_intake
forbidden_modules =
    mde_llm_gateway
    mde_compass
    mde_research_agent
    mde_spec_agent
    mde_verify_agent
    mde_spec_builder
    mde_spec_loader
    mde_flow
    mde_context_api
    mde_cli
    fastapi
    uvicorn
    httpx
allow_indirect_imports = True
