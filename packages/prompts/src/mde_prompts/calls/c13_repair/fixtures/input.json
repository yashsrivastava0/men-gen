  "blocks": [
    {
      "id": "SCR-006",
      "kind": "screen",
      "text": "route: /product/[id]\nrecipe: detail-with-sticky-cta\npurpose: Show one product and let the shopper add it to the cart\nflow: FLW-001\ndata:\n  - bind: API-getProduct(id)\n    show:\n      - name\n      - gallery\n      - price\n      - compare_at_price\n      - rating\n      - rating_count\n      - description\n      - variants\n      - in_stock\nsections:\n  - gallery\n  - title_price\n  - favorite_button\n  - variant_picker\n  - description\n  - delivery_info\n  - reviews_preview\n  - sticky_cta\nactions:\n  - add_to_cart: {calls: API-addCartItem, on_success: toast and the cart badge count goes up}\n  - view_cart: {go: SCR-011}\n  - toggle_favorite: {calls: API-addFavorite, on_success: the heart fills in}\n  - see_all_reviews: {go: SCR-007}\n  - broken: {go: SCR-099}\nstates:\n  out_of_stock: {disable: add_to_cart, show: notify_me}\ncopy: {cta: Add to cart}\nchecks:\n  - Add to cart increases the cart badge by the chosen quantity\n  - An out-of-stock variant disables the button\n  - A variant must be chosen before adding when the product has variants\n"
    }
  ],
  "round": 1
}
