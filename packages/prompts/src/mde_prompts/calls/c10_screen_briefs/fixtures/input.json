        "cart",
        "product",
        "variant",
        "quantity",
        "unit_price"
      ]
    },
    {
      "id": "ENT-Cart",
      "name": "Cart",
      "fields": [
        "user",
        "item_count",
        "subtotal",
        "shipping_fee",
        "total"
      ]
    },
    {
