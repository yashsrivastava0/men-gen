        "name",
        "description",
        "price",
        "compare_at_price",
        "image",
        "gallery",
        "category",
        "brand",
        "rating",
        "rating_count",
        "in_stock"
      ]
    },
    {
      "id": "ENT-CartItem",
      "name": "Cart item",
