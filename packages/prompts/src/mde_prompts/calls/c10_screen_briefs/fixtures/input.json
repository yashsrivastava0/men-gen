    },
    {
      "id": "ENT-Order",
      "name": "Order",
      "fields": [
        "user",
        "status",
        "shipping_address",
        "items_total",
        "shipping_fee",
        "total",
        "payment_method",
        "placed_at",
        "estimated_delivery",
        "tracking_code",
        "cancel_reason"
      ]
    }
  ],
  "operations": [
    {
      "id": "API-getProduct",
      "method": "GET",
      "path": "/products/{id}"
    },
    {
      "id": "API-addCartItem",
      "method": "POST",
      "path": "/cart/items"
    },
    {
      "id": "API-addFavorite",
      "method": "POST",
      "path": "/favorites"
    },
    {
      "id": "API-getCart",
      "method": "GET",
      "path": "/cart"
    },
    {
      "id": "API-updateCartItem",
      "method": "PATCH",
      "path": "/cart/items/{id}"
    },
    {
      "id": "API-removeCartItem",
      "method": "DELETE",
      "path": "/cart/items/{id}"
    },
    {
      "id": "API-listAddresses",
      "method": "GET",
      "path": "/addresses"
    },
    {
      "id": "API-createPayment",
      "method": "POST",
      "path": "/payments"
    },
    {
      "id": "API-createOrder",
      "method": "POST",
      "path": "/orders"
    }
  ],
