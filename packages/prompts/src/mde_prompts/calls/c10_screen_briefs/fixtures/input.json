  "screens": [
    {
      "id": "SCR-006",
      "route": "/product/[id]",
      "recipe": "detail-with-sticky-cta",
      "surface": "customer",
      "purpose": "Show one product and let the shopper add it to the cart",
      "sections": [
        "gallery",
        "title_price",
        "favorite_button",
        "variant_picker",
        "description",
        "delivery_info",
        "reviews_preview",
        "sticky_cta"
      ],
      "actions": [
        "add_to_cart -> API-addCartItem",
        "view_cart -> SCR-011",
        "toggle_favorite -> API-addFavorite",
        "see_all_reviews -> SCR-007"
      ],
      "copy_keys": [
        "cta"
      ]
    },
    {
      "id": "SCR-011",
      "route": "/cart",
      "recipe": "list",
      "surface": "customer",
      "purpose": "Review the items, change quantities and continue to checkout",
      "sections": [
        "cart_items",
        "order_totals",
        "checkout_cta"
      ],
      "actions": [
        "change_quantity -> API-updateCartItem",
        "remove_item -> API-removeCartItem",
        "checkout -> SCR-012",
        "keep_shopping -> SCR-004"
      ],
      "copy_keys": [
        "title",
        "cta"
      ]
    },
    {
      "id": "SCR-012",
      "route": "/checkout",
      "recipe": "checkout-review",
      "surface": "customer",
      "purpose": "Confirm the address and payment and place the order",
      "sections": [
        "order_summary",
        "delivery_address",
        "payment_method",
        "price_breakdown",
        "place_cta"
      ],
      "actions": [
        "change_address -> SCR-020",
        "choose_payment -> SCR-022",
        "pay_now -> API-createPayment",
        "payment_declined -> SCR-014",
        "place_order -> API-createOrder"
      ],
      "copy_keys": [
        "title",
        "cta"
      ]
    }
  ],
  "recipes": [
    {
      "id": "list",
      "kind": "list",
      "default_sections": [
        "header",
        "items",
        "load_more"
      ]
    },
    {
      "id": "detail-with-sticky-cta",
      "kind": "detail",
      "default_sections": [
        "gallery",
        "title_price",
        "option_picker",
        "description",
        "related_items",
        "sticky_cta"
      ]
    },
    {
      "id": "checkout-review",
      "kind": "other",
      "default_sections": [
        "order_summary",
        "address_or_time",
        "payment_method",
        "price_breakdown",
        "place_cta"
      ]
    }
  ],
  "entities": [
    {
      "id": "ENT-Product",
      "name": "Product",
