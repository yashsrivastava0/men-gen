{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "minProperties": 1,
 "properties": {
  "delivery_fee": {
   "additionalProperties": false,
   "properties": {
    "amount": {
     "description": "minor units, never a float",
     "type": "integer"
    },
    "currency": {
     "pattern": "^[A-Z]{3}$",
     "type": "string"
    }
   },
   "required": [
    "amount",
    "currency"
   ],
   "type": "object"
  },
  "dropoff_location": {
   "additionalProperties": false,
   "properties": {
    "lat": {
     "maximum": 90,
     "minimum": -90,
     "type": "number"
    },
    "lng": {
     "maximum": 180,
     "minimum": -180,
     "type": "number"
    }
   },
   "required": [
    "lat",
    "lng"
   ],
   "type": "object"
  },
  "order_id": {
   "type": "string",
   "x-ref": "ENT-006"
  },
  "pickup_location": {
   "additionalProperties": false,
   "properties": {
    "lat": {
     "maximum": 90,
     "minimum": -90,
     "type": "number"
    },
    "lng": {
     "maximum": 180,
     "minimum": -180,
     "type": "number"
    }
   },
   "required": [
    "lat",
    "lng"
   ],
   "type": "object"
  },
  "status": {
   "enum": [
    "unassigned",
    "assigned",
    "picked_up",
    "delivered",
    "unable_to_deliver"
   ],
   "type": "string"
  },
  "transport_partner_id": {
   "type": "string",
   "x-ref": "ENT-009"
  }
 },
 "title": "Delivery changes",
 "type": "object",
 "x-entity": "ENT-008"
}
