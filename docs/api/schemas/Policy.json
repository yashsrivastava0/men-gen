          "type": "integer"
        },
        "max_turns": {
          "default": 30,
          "title": "Max Turns",
          "type": "integer"
        },
        "research_budget_usd": {
          "default": "0.30",
          "title": "Research Budget Usd",
          "type": "string"
        },
        "session_budget_usd": {
          "default": "0.50",
          "title": "Session Budget Usd",
          "type": "string"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "ModelPolicy": {
      "additionalProperties": false,
      "properties": {
        "providers": {
          "default": [
            "openai"
