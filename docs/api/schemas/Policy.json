    "GateRule": {
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "items": {
            "type": "string"
          },
          "title": "Approvers",
          "type": "array"
        },
        "full_file_view": {
          "default": false,
          "title": "Full File View",
          "type": "boolean"
        },
        "reminder_hours": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reminder Hours"
        }
      },
      "required": [
        "approvers"
      ],
      "title": "GateRule",
      "type": "object"
    },
    "Limits": {
