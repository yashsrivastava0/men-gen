      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Banned Libraries",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "gates": {
      "$ref": "#/$defs/PolicyGates"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "inherits": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
