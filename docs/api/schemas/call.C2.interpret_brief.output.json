{
  "$defs": {
    "ArchetypeCandidate": {
      "additionalProperties": false,
      "properties": {
        "archetype_id": {
          "title": "Archetype Id",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "archetype_id",
        "confidence"
      ],
      "title": "ArchetypeCandidate",
      "type": "object"
    },
    "SlotUpdate": {
      "additionalProperties": false,
      "description": "A slot value found in text. Exactly one of the value fields is set (or ``negate``).",
      "properties": {
        "confidence": {
          "default": 0.8,
          "description": "0 to 1",
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "default": "",
          "description": "Short quote or paraphrase of the evidence",
          "title": "Evidence",
          "type": "string"
        },
        "negate": {
          "default": false,
          "description": "True if the user explicitly negated it",
          "title": "Negate",
          "type": "boolean"
        },
        "slot_id": {
          "enum": [
            "idea.summary",
            "idea.archetype",
            "scope.apps",
            "scope.features",
            "users.roles",
            "auth.method",
            "design.direction",
            "brand.name",
            "brand.assets",
            "design.accent",
            "design.mode",
            "design.nav_style",
            "pay.model",
            "pay.provider",
            "data.source",
            "behavior.offline",
            "behavior.notifications",
            "behavior.analytics",
            "locale",
            "a11y",
            "compliance.flags",
            "auth.sso",
            "integrations.list",
            "data.classification",
            "regions",
            "release.channel",
            "approvers"
          ],
          "title": "Slot Id",
          "type": "string"
        },
        "value_bool": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boolean value, or null",
          "title": "Value Bool"
        },
        "value_list": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List value, or null",
          "title": "Value List"
        },
        "value_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text/choice value, or null",
          "title": "Value Text"
        }
      },
      "required": [
        "slot_id"
      ],
      "title": "SlotUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "app_count_hint": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "App Count Hint"
    },
    "archetype_candidates": {
      "items": {
        "$ref": "#/$defs/ArchetypeCandidate"
      },
      "title": "Archetype Candidates",
      "type": "array"
    },
    "multi_app": {
      "default": false,
      "title": "Multi App",
      "type": "boolean"
    },
    "named_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Named References",
      "type": "array"
    },
    "one_sentence_idea": {
      "title": "One Sentence Idea",
      "type": "string"
    },
    "regions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Regions",
      "type": "array"
    },
    "sensitive_flags": {
      "default": [],
      "description": "Ids from the provided sensitive domain options only",
      "items": {
        "type": "string"
      },
      "title": "Sensitive Flags",
      "type": "array"
    },
    "size_estimate": {
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "title": "Size Estimate",
      "type": "string"
    },
    "unsupported_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Id from the provided unsupported types, or null",
      "title": "Unsupported Type"
    },
    "volunteered": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SlotUpdate"
      },
      "title": "Volunteered",
      "type": "array"
    }
  },
  "required": [
    "one_sentence_idea",
    "archetype_candidates"
  ],
  "title": "C2Output",
  "type": "object"
}
